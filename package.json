{
  "name": "giviloop",
  "version": "0.8.2",
  "description": "Double-check your coding agent with web chat or local models. Saved reviews, CLI and MCP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "givi": "./dist/cli.js",
    "givi-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 test/browser/*.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "givi": "node dist/cli.js",
    "mcp": "node dist/mcp-server.js",
    "chatgpt:web": "node dist/playground-chatgpt-web.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs/accesso-provider.md",
    "docs/troubleshooting.md",
    "docs/release-readiness-2026-09-21.md",
    "CONTRIBUTING.md",
    "docs/ollama.md",
    "docs/dwarfstar.md",
    "docs/local-inference-validation-2026-09-21.md",
    "LICENSE",
    "docs/local-engines.md",
    "docs/production-validation-2026-09-21.md",
    "docs/chatgpt-403-resolution-2026-09-21.md",
    "docs/usage.md",
    "docs/double-check.md",
    "docs/roadmap.md",
    "examples/double-check/sum.ts",
    "docs/costs-and-access.md",
    "docs/releases/0.3.0.md",
    "examples/double-check/verify.mjs",
    "docs/demo.md",
    "docs/e2e-validation-2026-09-21.md",
    "docs/releases/0.3.1.md",
    "docs/capabilities-and-validation-2026-09-22.md",
    "docs/web-providers.md",
    "docs/releases/0.4.0.md",
    "docs/setup-and-evidence.md",
    "docs/releases/0.5.0.md",
    "docs/releases/0.6.0.md",
    "docs/before-commit.md",
    "docs/releases/0.7.0.md",
    "docs/examples/double-check-report.md",
    "docs/automatic-review.md",
    "docs/releases/0.8.0.md",
    "docs/releases/0.8.1.md",
    "docs/releases/0.8.2.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.61.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vgflutter/GiviLoop.git"
  },
  "homepage": "https://github.com/vgflutter/GiviLoop#readme",
  "bugs": {
    "url": "https://github.com/vgflutter/GiviLoop/issues"
  },
  "keywords": [
    "code-review",
    "double-check",
    "mcp",
    "coding-agent",
    "chatgpt",
    "ollama",
    "local-llm"
  ]
}
